#usda 1.0
(
    defaultPrim = "CraneRoot"
    metersPerUnit = 1
    upAxis = "Z"
)

def "CraneRoot"
{
    def "Looks"
    {
        def Material "Yellow"
        {
            token outputs:surface.connect = </CraneRoot/Looks/Yellow/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.66, 0.1)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Gray"
        {
            token outputs:surface.connect = </CraneRoot/Looks/Gray/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.32, 0.36)
                float inputs:metallic = 0.4
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Dark"
        {
            token outputs:surface.connect = </CraneRoot/Looks/Dark/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.12, 0.14)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "Red"
        {
            token outputs:surface.connect = </CraneRoot/Looks/Red/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.15, 0.12)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "MagnetRing"
        {
            token outputs:surface.connect = </CraneRoot/Looks/MagnetRing/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.02, 0.02)
                color3f inputs:emissiveColor = (1, 0.15, 0.1)
                float inputs:emissiveIntensity = 1.2
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

