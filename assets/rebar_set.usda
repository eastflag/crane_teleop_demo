def "RebarSet"
{
    def "Looks"
    {
        def Material "RebarMat0"
        {
            token outputs:surface.connect = </RebarSet/Looks/RebarMat0/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.3, 0.15)
                float inputs:metallic = 0.35
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

